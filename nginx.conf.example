# Include inside the existing HTTPS server used by New API.
# Forward the whole cockpit prefix unchanged. Keep New API's / location as-is.
location = /cockpit {
    absolute_redirect off;
    return 302 /cockpit/statistics/$is_args$args;
}
location ^~ /cockpit/ {
    proxy_pass http://127.0.0.1:8091;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 90s;
}
