recursive-include sql *.sql
recursive-include tests/fixtures *.sql
graft frontend/studio
prune frontend/studio/node_modules
prune vsix
include docs/image-studio-sources.md
recursive-include patches/new-api *.patch *.sh *.md LICENSE NOTICE
# A graft includes untracked files too; ignore local/private configuration
# independently of Git. Public examples are explicitly restored afterwards.
global-exclude .env .env.* *.private *.private.* *.local *.local.*
global-exclude *.pem *.key *.p12 *.pfx *.keystore *.jks
prune secrets
prune credentials
prune frontend/studio/secrets
prune frontend/studio/credentials
include .env.example
