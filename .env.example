PGHOST=postgres
PGPORT=5432
PGDATABASE=new-api
PGUSER=statistics_reader
PGPASSWORD=
PORT=8091
# Keep 127.0.0.1 behind Nginx; use 0.0.0.0 for direct network access without Nginx.
BIND_HOST=127.0.0.1
PYTHON_IMAGE=python:3.12-slim
NEW_API_NETWORK=new-api-network
# New API internal service URL; used only for authenticated add/subtract quota operations.
NEW_API_INTERNAL_URL=http://new-api:3000
# Separate database for budget settings, monthly ledger, alerts and quota schedules.
# Required for quota-worker; enable it with --profile quota-schedules.
# Leave empty to disable persistence-dependent monitoring/scheduling features.
MONITOR_DATABASE_URL=
# Fernet key for encrypted notification credentials; preserve across deployments.
NOTIFICATION_ENCRYPTION_KEY=
