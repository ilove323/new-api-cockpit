PGHOST=postgres
PGPORT=5432
PGDATABASE=new-api
PGUSER=cockpit_reader
PGPASSWORD=
PORT=8091
# Bind the proxy/health port to loopback. Browser login requires same-origin New API routes.
BIND_HOST=127.0.0.1
PYTHON_IMAGE=python:3.12-slim
NEW_API_NETWORK=new-api-network
# New API internal service URL; used for browser session validation and management APIs.
NEW_API_INTERNAL_URL=http://new-api:3000
# Keep true with HTTPS. Set false only for explicitly trusted HTTP development/intranet.
COCKPIT_COOKIE_SECURE=true
# Separate database for budgets, ledger, alerts, schedules and user/KEY/quota operation records.
# Enables the application's built-in balance/quota timers.
# Required for all user/KEY/quota writes; leave empty for read-only functionality.
MONITOR_DATABASE_URL=
# Fernet key for encrypted notification credentials; preserve across deployments.
NOTIFICATION_ENCRYPTION_KEY=

# User management reuses source PG credentials. Ordinary queries stay read-only;
# grant EXECUTE on the restricted ensure-PAT function (sql/source_pat_function.sql).
# Never configure user PATs in this file.
