+// Opt-in only: fixed Unix sockets, fixture identity/database and an empty schema.
+// No DSN or network address from the environment can select a real account DB.
+func TestTokenConfigPatchDatabaseConcurrency(t *testing.T) {
+	dialect := os.Getenv("COCKPIT_NEWAPI_TEST_DATABASE")
+	if dialect == "" {
+		t.Skip("requires isolated Unix-socket database and Redis fixtures")
+	}
+	var driver gorm.Dialector
+	var databaseType common.DatabaseType
+	switch dialect {
+	case "postgres":
+		driver = postgres.Open("host=/fixture/pg user=fixture_admin dbname=cockpit_token_config_fixture sslmode=disable")
+		databaseType = common.DatabaseTypePostgreSQL
+	case "mysql":
+		driver = mysql.Open("fixture_admin:fixture-only-not-real@unix(/fixture/mysql/mysql.sock)/cockpit_token_config_fixture?charset=utf8mb4&parseTime=true&loc=UTC")
+		databaseType = common.DatabaseTypeMySQL
+	default:
+		t.Fatal("unsupported fixture database")
+	}
+	db, err := gorm.Open(driver, &gorm.Config{})
+	require.NoError(t, err)
+	sqlDB, err := db.DB()
+	require.NoError(t, err)
+	sqlDB.SetMaxOpenConns(4)
+	t.Cleanup(func() { _ = sqlDB.Close() })
+	var name, user, version string
+	if dialect == "postgres" {
+		require.NoError(t, db.Raw("SELECT current_database(), current_user, version()").Row().Scan(&name, &user, &version))
+	} else {
+		require.NoError(t, db.Raw("SELECT DATABASE(), CURRENT_USER(), VERSION()").Row().Scan(&name, &user, &version))
+	}
+	require.Equal(t, "cockpit_token_config_fixture", name)
+	require.Equal(t, "fixture_admin", strings.Split(user, "@")[0])
+	tables, err := db.Migrator().GetTables()
+	require.NoError(t, err)
+	require.Empty(t, tables, "fixture must be a newly created empty database")
+	t.Logf("isolated database %s: %s", dialect, version)
+	oldDB, oldType := DB, common.MainDatabaseType()
+	DB = db
+	common.SetDatabaseTypes(databaseType, common.LogDatabaseType())
+	initCol()
+	t.Cleanup(func() { DB = oldDB; common.SetDatabaseTypes(oldType, common.LogDatabaseType()); initCol() })
+	for range 2 {
+		require.NoError(t, DB.AutoMigrate(&Token{}))
+	}
+	require.False(t, DB.Migrator().HasColumn(&Token{}, "config_pending"), "cache marker must not change the SQL schema")
+	client := redis.NewClient(&redis.Options{Network: "unix", Addr: "/fixture/redis/redis.sock"})
+	require.NoError(t, client.Ping(t.Context()).Err())
+	count, err := client.DBSize(t.Context()).Result()
+	require.NoError(t, err)
+	require.Zero(t, count, "Redis must be a newly created isolated instance")
+	oldRedisEnabled, oldRDB := common.RedisEnabled, common.RDB
+	common.RedisEnabled, common.RDB = true, client
+	t.Cleanup(func() { common.RedisEnabled, common.RDB = oldRedisEnabled, oldRDB; _ = client.Close() })
+	token := Token{UserId: 7, Key: "synthetic-database-config-key", Name: "before", Group: "default", ExpiredTime: -1, Status: common.TokenStatusEnabled, RemainQuota: 100}
+	require.NoError(t, DB.Create(&token).Error)
+	_, err = cacheInitToken(token)
+	require.NoError(t, err)
+	// Keep a config transaction open after its row lock. A concurrent SQL
+	// deduction must be blocked, while a Redis reservation may proceed.
+	locked, release, finished, completed := make(chan struct{}), make(chan struct{}), make(chan struct{}), make(chan error, 1)
+	released := false
+	t.Cleanup(func() {
+		if !released {
+			close(release)
+		}
+		<-finished
+	})
+	go func() {
+		defer close(finished)
+		_, err := PatchTokenConfig(t.Context(), token.Id, token.UserId, func(*Token) (map[string]any, error) {
+			close(locked)
+			select {
+			case <-release:
+				return changeConfigGroup(nil)
+			case <-t.Context().Done():
+				return nil, t.Context().Err()
+			}
+		})
+		completed <- err
+	}()
+	select {
+	case <-locked:
+	case <-time.After(3 * time.Second):
+		t.Fatal("configuration writer did not acquire its row")
+	}
+	_, err = cacheApplyTokenQuotaDelta(token.Id, token.Key, -10)
+	require.NoError(t, err)
+	ctx, cancel := context.WithTimeout(t.Context(), 2*time.Second)
+	defer cancel()
+	tx := DB.WithContext(ctx).Begin()
+	require.NoError(t, tx.Error)
+	defer tx.Rollback()
+	if dialect == "postgres" {
+		require.NoError(t, tx.Exec("SET LOCAL lock_timeout = '100ms'").Error)
+	} else {
+		require.NoError(t, tx.Exec("SET SESSION innodb_lock_wait_timeout = 1").Error)
+	}
+	blocked := tx.Model(&Token{}).Where("id = ?", token.Id).UpdateColumn("remain_quota", gorm.Expr("remain_quota - 10")).Error
+	require.Error(t, blocked, "a second SQL writer must not bypass the configuration row lock")
+	if dialect == "postgres" {
+		var lockError *pgconn.PgError
+		require.ErrorAs(t, blocked, &lockError)
+		require.Equal(t, "55P03", lockError.Code)
+	} else {
+		var lockError *sqlmysql.MySQLError
+		require.ErrorAs(t, blocked, &lockError)
+		require.EqualValues(t, 1205, lockError.Number)
+	}
+	require.NoError(t, tx.Rollback().Error)
+	close(release)
+	released = true
+	result := <-completed
+	require.NoError(t, result)
+	cached, err := cacheGetTokenByKey(token.Key)
+	require.NoError(t, err)
+	require.Equal(t, "vip", cached.Group)
+	require.Equal(t, 90, cached.RemainQuota, "metadata completion must not erase a live Redis reservation")
+	require.NoError(t, decreaseTokenQuota(token.Id, 10))
+	// A stale client snapshot of 100 never enters the configuration patch.
+	_, err = PatchTokenConfig(t.Context(), token.Id, token.UserId, func(*Token) (map[string]any, error) { return map[string]any{"name": "after"}, nil })
+	require.NoError(t, err)
+	var stored Token
+	require.NoError(t, DB.First(&stored, token.Id).Error)
+	require.Equal(t, 90, stored.RemainQuota)
+	require.Equal(t, 10, stored.UsedQuota)
+	require.Equal(t, "vip", stored.Group)
+	require.Equal(t, "after", stored.Name)
+	require.Equal(t, -int64(1), stored.ExpiredTime)
+	cached, err = cacheGetTokenByKey(token.Key)
+	require.NoError(t, err)
+	require.Equal(t, 90, cached.RemainQuota)
+	require.Equal(t, 10, cached.UsedQuota)
+	require.Empty(t, cached.ConfigPending)
+}
