+// SPDX-License-Identifier: AGPL-3.0-only
+package model
+
+import (
+	"context"
+	"errors"
+	"os"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/go-redis/redis/v8"
+	sqlmysql "github.com/go-sql-driver/mysql"
+	"github.com/jackc/pgx/v5/pgconn"
+	"github.com/stretchr/testify/require"
+	"gorm.io/driver/mysql"
+	"gorm.io/driver/postgres"
+	"gorm.io/gorm"
+)
+
+func tokenConfigFixture(t *testing.T) Token {
+	t.Helper()
+	truncateTables(t)
+	useUserCacheMiniRedis(t)
+	ips := "203.0.113.7"
+	token := Token{UserId: 7, Key: "synthetic-config-patch-key", Name: "original", Group: "default",
+		Status: common.TokenStatusEnabled, ExpiredTime: 2100000000, RemainQuota: 100,
+		ModelLimitsEnabled: true, ModelLimits: "synthetic-model", AllowIps: &ips, AllowUserQuotaQuery: true}
+	require.NoError(t, token.Insert())
+	_, err := cacheInitToken(token)
+	require.NoError(t, err)
+	return token
+}
+
+func changeConfigGroup(token *Token) (map[string]any, error) {
+	return map[string]any{"group": "vip", "cross_group_retry": false, "auto_groups": ""}, nil
+}
+
+func TestTokenConfigPatchPreservesBothSqlDeductionAndLiveRedisPreconsume(t *testing.T) {
+	token := tokenConfigFixture(t)
+	// Redis is ahead of a batched SQL write, exactly the state that must not
+	// be replaced by a stale client/SQL quota snapshot during a group change.
+	require.NoError(t, common.RDB.HSet(context.Background(), getTokenCacheKey(token.Key), "RemainQuota", 90, "UsedQuota", 10).Err())
+	updated, err := PatchTokenConfig(context.Background(), token.Id, token.UserId, changeConfigGroup)
+	require.NoError(t, err)
+	require.Equal(t, "vip", updated.Group)
+	cached, err := cacheGetTokenByKey(token.Key)
+	require.NoError(t, err)
+	require.Equal(t, 90, cached.RemainQuota)
+	require.Equal(t, 10, cached.UsedQuota)
+	require.Equal(t, "vip", cached.Group)
+	require.Equal(t, token.Name, cached.Name)
+	require.Equal(t, token.ExpiredTime, cached.ExpiredTime)
+	require.Equal(t, token.ModelLimits, cached.ModelLimits)
+	require.Equal(t, *token.AllowIps, *cached.AllowIps)
+	// The queued deduction reaches SQL after the configuration write.
+	require.NoError(t, decreaseTokenQuota(token.Id, 10))
+	var stored Token
+	require.NoError(t, DB.First(&stored, token.Id).Error)
+	require.Equal(t, 90, stored.RemainQuota)
+	require.Equal(t, 10, stored.UsedQuota)
+	// A second configuration write also cannot restore the client's old 100.
+	_, err = PatchTokenConfig(context.Background(), token.Id, token.UserId, func(*Token) (map[string]any, error) { return map[string]any{"name": "renamed"}, nil })
+	require.NoError(t, err)
+	require.NoError(t, DB.First(&stored, token.Id).Error)
+	require.Equal(t, 90, stored.RemainQuota)
+	cached, err = cacheGetTokenByKey(token.Key)
+	require.NoError(t, err)
+	require.Equal(t, 90, cached.RemainQuota)
+}
