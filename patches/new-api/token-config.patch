index 0000000..ce4f4aa
--- /dev/null
+++ b/model/token_config_patch.go
@@ -0,0 +1,138 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+package model
+
+import (
+	"context"
+	"errors"
+	"slices"
+	"strconv"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/google/uuid"
+	"gorm.io/gorm"
+)
+
+var ErrInvalidTokenConfigPatch = errors.New("invalid token configuration patch")
+var errTokenConfigPending = errors.New("token configuration cache requires reconciliation")
+
+var tokenConfigColumns = map[string]bool{
+	"name": true, "expired_time": true, "model_limits_enabled": true,
+	"model_limits": true, "allow_ips": true, "allow_user_quota_query": true,
+	"group": true, "cross_group_retry": true, "auto_groups": true,
+}
+
+// PatchTokenConfig serializes configuration writers for this owner/token only.
+// No quota, usage, status, key or ownership field can enter the SQL UPDATE.
+// build validates current locked state; it must not dispatch external requests.
+func PatchTokenConfig(ctx context.Context, id, owner int, build func(*Token) (map[string]any, error)) (*Token, error) {
+	ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	marker := uuid.NewString()
+	var token Token
+	err := DB.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := lockForUpdate(tx).Where("id = ? AND user_id = ?", id, owner).First(&token).Error; err != nil {
+			return err
+		}
+		updates, err := build(&token)
+		if err != nil {
+			return err
+		}
+		if len(updates) == 0 {
+			return ErrInvalidTokenConfigPatch
+		}
+		columns := make([]string, 0, len(updates))
+		for column := range updates {
+			if !tokenConfigColumns[column] {
+				return ErrInvalidTokenConfigPatch
+			}
+			columns = append(columns, column)
+		}
+		slices.Sort(columns)
+		if err := prepareTokenConfigCache(ctx, token.Key, marker); err != nil {
+			return err
+		}
+		if err := tx.Model(&Token{}).Where("id = ? AND user_id = ?", id, owner).Select(columns).Updates(updates).Error; err != nil {
+			return err
+		}
+		return tx.Where("id = ? AND user_id = ?", id, owner).First(&token).Error
+	})
+	if err != nil {
+		// Even a COMMIT acknowledgement can be lost. Leave a pending marker;
+		// a subsequent read reconciles actual SQL state, without resending.
+		return nil, err
+	}
+	if err := finishTokenConfigCache(ctx, &token, marker); err != nil {
+		return nil, err
+	}
+	return &token, nil
+}
+
+func prepareTokenConfigCache(ctx context.Context, key, marker string) error {
+	if !common.RedisEnabled {
+		return nil
+	}
+	const script = `
+redis.call('SET', KEYS[2], 1, 'EX', ARGV[2])
+if redis.call('EXISTS', KEYS[1]) == 1 then
+  redis.call('HSET', KEYS[1], 'ConfigPending', ARGV[1])
+end
+return 1`
+	return common.RDB.Eval(ctx, script, []string{getTokenCacheKey(key), getTokenCacheFenceKey(key)}, marker, tokenCacheFenceSeconds).Err()
+}
+
+// Keep live Redis quota/pre-consume counters intact, including batched writes
+// that have not reached SQL. Never initialize a partial hash after eviction.
+// An older writer cannot replace a newer writer's pending configuration.
+func finishTokenConfigCache(ctx context.Context, token *Token, marker string) error {
+	if !common.RedisEnabled {
+		return nil
+	}
+	allowIPs := ""
+	if token.AllowIps != nil {
+		allowIPs = *token.AllowIps
+	}
+	const script = `
+if redis.call('HGET', KEYS[1], 'ConfigPending') ~= ARGV[1] then
+  return 0
+end
+redis.call('HSET', KEYS[1],
+  'Name', ARGV[2], 'ExpiredTime', ARGV[3],
+  'ModelLimitsEnabled', ARGV[4], 'ModelLimits', ARGV[5],
+  'AllowIps', ARGV[6], 'AllowUserQuotaQuery', ARGV[7],
+  'Group', ARGV[8], 'CrossGroupRetry', ARGV[9], 'AutoGroups', ARGV[10])
+redis.call('HDEL', KEYS[1], 'ConfigPending')
+return 1`
+	return common.RDB.Eval(ctx, script, []string{getTokenCacheKey(token.Key)},
+		marker, token.Name, token.ExpiredTime, strconv.FormatBool(token.ModelLimitsEnabled),
+		token.ModelLimits, allowIPs, strconv.FormatBool(token.AllowUserQuotaQuery),
+		token.Group, strconv.FormatBool(token.CrossGroupRetry), token.AutoGroups).Err()
+}
+
+// Recover a writer crash, lost COMMIT acknowledgement or cache completion
+// failure. The row lock waits for active configuration writers; only committed
+// metadata is published, and quota fields are never copied from a SQL snapshot.
+func repairTokenConfigCache(key string) (*Token, error) {
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	var token Token
+	err := DB.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := lockForUpdate(tx).Where(commonKeyCol+" = ?", key).First(&token).Error; err != nil {
+			return err
+		}
+		marker, err := common.RDB.HGet(ctx, getTokenCacheKey(key), "ConfigPending").Result()
+		if err != nil {
+			return err
+		}
+		return finishTokenConfigCache(ctx, &token, marker)
+	})
+	if err != nil {
+		return nil, err
+	}
+	// A newer mutation can start immediately; ordinary SQL fallback remains
+	// valid for that overlapping request instead of recursive repair/retry.
+	if cached, err := cacheGetTokenByKey(key); err == nil {
+		return cached, nil
+	}
+	return &token, nil
+}
