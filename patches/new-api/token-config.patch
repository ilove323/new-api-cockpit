diff --git a/controller/token_config_patch.go b/controller/token_config_patch.go
new file mode 100644
index 0000000..25275be
--- /dev/null
+++ b/controller/token_config_patch.go
@@ -0,0 +1,162 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+package controller
+
+import (
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"slices"
+	"strconv"
+	"strings"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/constant"
+	"github.com/QuantumNous/new-api/model"
+	"github.com/QuantumNous/new-api/service"
+	"github.com/QuantumNous/new-api/setting"
+	"github.com/gin-gonic/gin"
+	"gorm.io/gorm"
+)
+
+type tokenConfigPatchInput struct {
+	Name                *string              `json:"name"`
+	ExpiredTime         *int64               `json:"expired_time"`
+	ModelLimitsEnabled  *bool                `json:"model_limits_enabled"`
+	ModelLimits         *string              `json:"model_limits"`
+	AllowIps            json.RawMessage      `json:"allow_ips"`
+	AllowUserQuotaQuery *bool                `json:"allow_user_quota_query"`
+	Group               *string              `json:"group"`
+	CrossGroupRetry     *bool                `json:"cross_group_retry"`
+	AutoGroups          tokenAutoGroupsInput `json:"auto_groups"`
+}
+
+func readTokenConfigPatch(c *gin.Context) (*tokenConfigPatchInput, error) {
+	raw, err := io.ReadAll(http.MaxBytesReader(c.Writer, c.Request.Body, 65536))
+	if err != nil {
+		return nil, model.ErrInvalidTokenConfigPatch
+	}
+	var fields map[string]json.RawMessage
+	if common.Unmarshal(raw, &fields) != nil || len(fields) == 0 {
+		return nil, model.ErrInvalidTokenConfigPatch
+	}
+	allowed := map[string]bool{"name": true, "expired_time": true, "model_limits_enabled": true, "model_limits": true,
+		"allow_ips": true, "allow_user_quota_query": true, "group": true, "cross_group_retry": true, "auto_groups": true}
+	for key, value := range fields {
+		if !allowed[key] || (string(value) == "null" && key != "allow_ips" && key != "auto_groups") {
+			return nil, model.ErrInvalidTokenConfigPatch
+		}
+	}
+	var input tokenConfigPatchInput
+	if common.Unmarshal(raw, &input) != nil {
+		return nil, model.ErrInvalidTokenConfigPatch
+	}
+	if input.Name != nil && len(*input.Name) > 50 || input.ExpiredTime != nil && *input.ExpiredTime < -1 ||
+		input.ModelLimits != nil && len(*input.ModelLimits) > 32768 || input.Group != nil && (len(*input.Group) > 256 || strings.ContainsAny(*input.Group, "\r\n\x00")) {
+		return nil, model.ErrInvalidTokenConfigPatch
+	}
+	return &input, nil
+}
+
+func (input *tokenConfigPatchInput) changes(token *model.Token, userGroup string) (map[string]any, error) {
+	updates := map[string]any{}
+	if input.Name != nil {
+		updates["name"] = *input.Name
+	}
+	if input.ExpiredTime != nil {
+		updates["expired_time"] = *input.ExpiredTime
+	}
+	if input.ModelLimitsEnabled != nil {
+		updates["model_limits_enabled"] = *input.ModelLimitsEnabled
+	}
+	if input.ModelLimits != nil {
+		updates["model_limits"] = *input.ModelLimits
+	}
+	if input.AllowUserQuotaQuery != nil {
+		updates["allow_user_quota_query"] = *input.AllowUserQuotaQuery
+	}
+	if input.AllowIps != nil {
+		var ips *string
+		if common.Unmarshal(input.AllowIps, &ips) != nil || ips != nil && len(*ips) > 32768 {
+			return nil, model.ErrInvalidTokenConfigPatch
+		}
+		updates["allow_ips"] = ips
+	}
+	if input.Group != nil {
+		group := *input.Group
+		if group != "" && group != "auto" && !service.IsUserSelectableGroup(userGroup, group) {
+			return nil, model.ErrInvalidTokenConfigPatch
+		}
+		token.Group = group
+	}
+	if input.CrossGroupRetry != nil {
+		token.CrossGroupRetry = *input.CrossGroupRetry
+	}
+	if input.AutoGroups.Set {
+		if len(input.AutoGroups.Groups) > setting.GetMaxTokenAutoGroups() {
+			return nil, model.ErrInvalidTokenConfigPatch
+		}
+		seen := map[string]bool{}
+		for _, group := range input.AutoGroups.Groups {
+			if seen[group] || !service.IsUserSelectableGroup(userGroup, group) {
+				return nil, model.ErrInvalidTokenConfigPatch
+			}
+			seen[group] = true
+		}
+		if token.SetAutoGroups(input.AutoGroups.Groups) != nil {
+			return nil, model.ErrInvalidTokenConfigPatch
+		}
+	}
+	if input.Group != nil || input.CrossGroupRetry != nil || input.AutoGroups.Set {
+		if token.Group != "auto" {
+			token.CrossGroupRetry = false
+			_ = token.SetAutoGroups(nil)
+		}
+		updates["group"], updates["cross_group_retry"], updates["auto_groups"] = token.Group, token.CrossGroupRetry, token.AutoGroups
+	}
+	return updates, nil
+}
+
+// PatchTokenConfig is an OWNER-scoped configuration endpoint, not an admin
+// impersonation endpoint. Financial fields are rejected, not defaulted to zero.
+func PatchTokenConfig(c *gin.Context) {
+	id, err := strconv.Atoi(c.Param("id"))
+	if err != nil || id <= 0 {
+		c.JSON(http.StatusBadRequest, gin.H{"success": false, "message": "Invalid token ID"})
+		return
+	}
+	input, err := readTokenConfigPatch(c)
+	if err != nil {
+		c.JSON(http.StatusBadRequest, gin.H{"success": false, "message": "Invalid token configuration patch"})
+		return
+	}
+	userGroup, err := getTokenRequestUserGroup(c)
+	if err != nil {
+		common.ApiError(c, err)
+		return
+	}
+	var fields []string
+	token, err := model.PatchTokenConfig(c.Request.Context(), id, c.GetInt("id"), func(current *model.Token) (map[string]any, error) {
+		updates, err := input.changes(current, userGroup)
+		for field := range updates {
+			fields = append(fields, field)
+		}
+		return updates, err
+	})
+	if err != nil {
+		status, message := http.StatusServiceUnavailable, "Token update result unavailable; query current state before retrying"
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			status, message = http.StatusNotFound, "Token not found"
+		}
+		if errors.Is(err, model.ErrInvalidTokenConfigPatch) {
+			status, message = http.StatusBadRequest, "Invalid token configuration patch"
+		}
+		c.JSON(status, gin.H{"success": false, "message": message})
+		return
+	}
+	slices.Sort(fields)
+	params := tokenAuditParams(c)
+	params["id"], params["name"], params["changed_fields"] = token.Id, token.Name, fields
+	common.SetContextKey(c, constant.ContextKeyTokenAuditSucceeded, true)
+	c.JSON(http.StatusOK, gin.H{"success": true, "message": "", "data": buildMaskedTokenResponse(token)})
+}
